# Telegram Bot Configuration
# Get your token from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Bot Username (without @) to show in video captions (e.g. KiwiDownloaderBot)
BOT_USERNAME=KiwiDownloaderBot

# Bot Owner Telegram User ID (get yours from @userinfobot, or send /claimowner)
OWNER_ID=0

# KiwiAPI Backend Service
API_BASE=https://api.kiwiapi.net
API_KEY=your_kiwiapi_key_here

# Temp directory for downloading files before sending to Telegram
TEMP_DIR=./tmp
